[
  {
    "id": "u1",
    "title": "Bonjour !",
    "blurb": "Greetings and meeting people",
    "lessons": [
      {
        "id": "u1-l1",
        "title": "Hello and goodbye",
        "phrases": [
          {
            "fr": "Bonjour",
            "en": "Hello",
            "note": "Say bonjour to everyone, every time you enter a shop or start a conversation. Skipping it comes across as rude."
          },
          {
            "fr": "Bonsoir",
            "en": "Good evening",
            "note": "Bonsoir works for hello and goodbye in the evening; Bonne soirée is the warmer goodbye."
          },
          {
            "fr": "Salut",
            "en": "Hi (informal)",
            "note": "Salut is for friends and people your age. With strangers, stay with Bonjour and vous."
          },
          {
            "fr": "Au revoir",
            "en": "Goodbye"
          },
          {
            "fr": "À bientôt",
            "en": "See you soon"
          },
          {
            "fr": "Bonne journée",
            "en": "Have a good day"
          }
        ]
      },
      {
        "id": "u1-l2",
        "title": "Meeting someone",
        "phrases": [
          {
            "fr": "Comment vous appelez-vous ?",
            "en": "What is your name?",
            "note": "Vous is the polite 'you' for adults you don't know. Tu is for friends and children."
          },
          {
            "fr": "Je m'appelle Marie",
            "en": "My name is Marie"
          },
          {
            "fr": "Enchanté",
            "en": "Nice to meet you",
            "note": "A woman writes enchantée; it sounds the same."
          },
          {
            "fr": "Comment allez-vous ?",
            "en": "How are you?"
          },
          {
            "fr": "Très bien, merci",
            "en": "Very well, thank you"
          },
          {
            "fr": "Je viens des États-Unis",
            "en": "I come from the United States",
            "note": "Country names take an article: les États-Unis, so it becomes des États-Unis."
          }
        ]
      },
      {
        "id": "u1-l3",
        "title": "Small talk",
        "phrases": [
          {
            "fr": "Ça va ?",
            "en": "How's it going? (casual)",
            "note": "Ça va is relaxed but fine with almost anyone; the usual answer is Ça va bien."
          },
          {
            "fr": "Ça va bien, et vous ?",
            "en": "I'm doing well, and you?"
          },
          {
            "fr": "Pas mal",
            "en": "Not bad"
          },
          {
            "fr": "Vous êtes d'ici ?",
            "en": "Are you from around here?"
          },
          {
            "fr": "C'est ma première fois en France",
            "en": "It's my first time in France"
          },
          {
            "fr": "Vous habitez ici depuis longtemps ?",
            "en": "Have you lived here long?"
          },
          {
            "fr": "On se tutoie ?",
            "en": "Shall we say tu to each other?",
            "note": "Tu is the informal 'you'; people your age often switch to it quickly, but let the French person lead."
          }
        ]
      },
      {
        "id": "u1-l4",
        "title": "Thanks and goodbyes",
        "phrases": [
          {
            "fr": "Bonne soirée",
            "en": "Have a good evening"
          },
          {
            "fr": "Bon week-end !",
            "en": "Have a good weekend!"
          },
          {
            "fr": "À demain",
            "en": "See you tomorrow"
          },
          {
            "fr": "À plus tard",
            "en": "See you later",
            "note": "Friends shorten it to À plus, and text it as A+."
          },
          {
            "fr": "Merci pour tout",
            "en": "Thanks for everything"
          },
          {
            "fr": "C'était un plaisir",
            "en": "It was a pleasure"
          },
          {
            "fr": "Prenez soin de vous",
            "en": "Take care",
            "note": "With a friend you would say Prends soin de toi (tu form)."
          },
          {
            "fr": "Bonne continuation",
            "en": "All the best from here on"
          }
        ]
      }
    ]
  },
  {
    "id": "u2",
    "title": "En route",
    "blurb": "Trams, trains and directions",
    "lessons": [
      {
        "id": "u2-l1",
        "title": "Getting around",
        "phrases": [
          {
            "fr": "Où est la gare ?",
            "en": "Where is the train station?",
            "note": "Locals just say la gare. Strasbourg's main station is the Gare Centrale."
          },
          {
            "fr": "Un ticket de tram, s'il vous plaît",
            "en": "One tram ticket, please",
            "note": "Buy tickets at the machine on the platform, then validate them before boarding."
          },
          {
            "fr": "Quel tram va à la cathédrale ?",
            "en": "Which tram goes to the cathedral?"
          },
          {
            "fr": "À quelle heure part le train ?",
            "en": "What time does the train leave?"
          },
          {
            "fr": "C'est loin ?",
            "en": "Is it far?"
          },
          {
            "fr": "Pouvez-vous m'aider ?",
            "en": "Can you help me?"
          },
          {
            "fr": "Où est l'arrêt de tram ?",
            "en": "Where is the tram stop?"
          },
          {
            "fr": "Faut-il valider le ticket ?",
            "en": "Does the ticket need to be validated?",
            "note": "Always validate. An unvalidated ticket can mean a fine."
          },
          {
            "fr": "Appelez les secours, s'il vous plaît !",
            "en": "Please call emergency services!",
            "note": "112 works everywhere in Europe; 15 = SAMU (medical), 17 = police."
          }
        ]
      },
      {
        "id": "u2-l2",
        "title": "Directions",
        "phrases": [
          {
            "fr": "Tout droit",
            "en": "Straight ahead"
          },
          {
            "fr": "À gauche",
            "en": "To the left"
          },
          {
            "fr": "À droite",
            "en": "To the right"
          },
          {
            "fr": "C'est près d'ici",
            "en": "It is near here"
          },
          {
            "fr": "Où sont les toilettes ?",
            "en": "Where is the restroom?"
          },
          {
            "fr": "Merci beaucoup",
            "en": "Thank you very much"
          },
          {
            "fr": "Je cherche mon groupe",
            "en": "I am looking for my group"
          }
        ]
      },
      {
        "id": "u2-l3",
        "title": "Tickets and trains",
        "phrases": [
          {
            "fr": "Où est-ce que je peux acheter un billet ?",
            "en": "Where can I buy a ticket?",
            "note": "Train tickets are billets; for the tram, locals say ticket or titre de transport."
          },
          {
            "fr": "Un aller simple pour Colmar, s'il vous plaît",
            "en": "A one-way ticket to Colmar, please"
          },
          {
            "fr": "Un aller-retour pour Paris, s'il vous plaît",
            "en": "A round-trip ticket to Paris, please"
          },
          {
            "fr": "De quel quai part le train ?",
            "en": "Which platform does the train leave from?",
            "note": "Departure boards show the platform as voie; it appears about 20 minutes before departure."
          },
          {
            "fr": "Le train a du retard",
            "en": "The train is delayed"
          },
          {
            "fr": "Est-ce que cette place est libre ?",
            "en": "Is this seat free?"
          },
          {
            "fr": "Est-ce que ce tram va à Kehl ?",
            "en": "Does this tram go to Kehl?",
            "note": "Tram D crosses the Rhine to Kehl in Germany, so carry your passport."
          },
          {
            "fr": "Où faut-il descendre ?",
            "en": "Where do I get off?"
          }
        ]
      },
      {
        "id": "u2-l4",
        "title": "Finding your way",
        "phrases": [
          {
            "fr": "Je ne sais pas où je suis",
            "en": "I don't know where I am"
          },
          {
            "fr": "Comment aller à la place Kléber ?",
            "en": "How do I get to Place Kléber?",
            "note": "Place Kléber is the main square, a short walk from the Homme de Fer tram hub."
          },
          {
            "fr": "C'est à cinq minutes à pied",
            "en": "It's a five-minute walk"
          },
          {
            "fr": "Tournez à gauche au feu",
            "en": "Turn left at the traffic light"
          },
          {
            "fr": "Prenez la deuxième rue à droite",
            "en": "Take the second street on the right"
          },
          {
            "fr": "Traversez le pont",
            "en": "Cross the bridge"
          },
          {
            "fr": "Pouvez-vous me montrer sur le plan ?",
            "en": "Can you show me on the map?",
            "note": "A city map is un plan; une carte is a country map or a restaurant menu."
          },
          {
            "fr": "C'est en face de la cathédrale",
            "en": "It's across from the cathedral"
          }
        ]
      }
    ]
  },
  {
    "id": "u3",
    "title": "Au café",
    "blurb": "Food, drink and politeness",
    "lessons": [
      {
        "id": "u3-l1",
        "title": "Ordering",
        "phrases": [
          {
            "fr": "Un café, s'il vous plaît",
            "en": "A coffee, please"
          },
          {
            "fr": "Je voudrais un croissant",
            "en": "I would like a croissant",
            "note": "Je voudrais ('I would like') is politer than Je veux ('I want')."
          },
          {
            "fr": "De l'eau, s'il vous plaît",
            "en": "Some water, please"
          },
          {
            "fr": "L'addition, s'il vous plaît",
            "en": "The bill, please",
            "note": "In France the bill only comes when you ask for it. Waiting is normal, not slow service."
          },
          {
            "fr": "C'est délicieux !",
            "en": "It is delicious!"
          },
          {
            "fr": "Je suis allergique aux fruits à coque",
            "en": "I am allergic to tree nuts"
          },
          {
            "fr": "Une carafe d'eau, s'il vous plaît",
            "en": "A jug of tap water, please",
            "note": "A carafe d'eau is free tap water. Without asking, you may get paid bottled water."
          },
          {
            "fr": "C'est combien ?",
            "en": "How much is it?"
          }
        ]
      },
      {
        "id": "u3-l2",
        "title": "Being polite",
        "phrases": [
          {
            "fr": "Merci",
            "en": "Thank you",
            "note": "Add beaucoup for more: merci beaucoup."
          },
          {
            "fr": "De rien",
            "en": "You are welcome",
            "note": "De rien is casual. Je vous en prie is the more formal 'you're welcome'."
          },
          {
            "fr": "Excusez-moi",
            "en": "Excuse me",
            "note": "Use excusez-moi to get someone's attention. Pardon is for bumping into someone, or for 'sorry, what?'."
          },
          {
            "fr": "Pardon",
            "en": "Sorry"
          },
          {
            "fr": "Je ne comprends pas",
            "en": "I do not understand"
          },
          {
            "fr": "Parlez-vous anglais ?",
            "en": "Do you speak English?",
            "note": "Say Bonjour first, then ask. Starting in French shows respect, and people usually help more."
          }
        ]
      },
      {
        "id": "u3-l3",
        "title": "A full meal",
        "phrases": [
          {
            "fr": "Une table pour quatre, s'il vous plaît",
            "en": "A table for four, please"
          },
          {
            "fr": "La carte, s'il vous plaît",
            "en": "The menu, please",
            "note": "La carte is the full menu; un menu is a fixed-price set meal."
          },
          {
            "fr": "Qu'est-ce que vous recommandez ?",
            "en": "What do you recommend?"
          },
          {
            "fr": "Je vais prendre le plat du jour",
            "en": "I'll have the dish of the day"
          },
          {
            "fr": "On peut commander ?",
            "en": "Can we order?"
          },
          {
            "fr": "Comme dessert, une tarte aux pommes",
            "en": "For dessert, an apple tart"
          },
          {
            "fr": "Est-ce qu'on peut payer séparément ?",
            "en": "Can we pay separately?",
            "note": "With a big group, ask before ordering: many restaurants prefer one bill per table."
          },
          {
            "fr": "C'était très bon, merci",
            "en": "It was very good, thanks"
          }
        ]
      },
      {
        "id": "u3-l4",
        "title": "Dietary needs",
        "phrases": [
          {
            "fr": "Je ne mange pas de viande",
            "en": "I don't eat meat",
            "note": "Je suis végétarien changes with gender (végétarienne), so this phrase works for everyone."
          },
          {
            "fr": "Est-ce qu'il y a du porc ?",
            "en": "Is there pork in it?",
            "note": "Alsatian dishes often hide pork, like the lardons on a tarte flambée."
          },
          {
            "fr": "Est-ce que c'est sans gluten ?",
            "en": "Is it gluten-free?"
          },
          {
            "fr": "Je suis allergique aux cacahuètes",
            "en": "I am allergic to peanuts",
            "note": "Ingredient labels usually say arachide instead of cacahuète."
          },
          {
            "fr": "Quels sont les ingrédients ?",
            "en": "What are the ingredients?"
          },
          {
            "fr": "Sans oignons, s'il vous plaît",
            "en": "No onions, please"
          },
          {
            "fr": "Je ne bois pas d'alcool",
            "en": "I don't drink alcohol"
          },
          {
            "fr": "C'est épicé ?",
            "en": "Is it spicy?"
          }
        ]
      }
    ]
  },
  {
    "id": "u4",
    "title": "Dans la rue",
    "blurb": "Starting conversations with kindness",
    "lessons": [
      {
        "id": "u4-l1",
        "title": "Starting a conversation",
        "phrases": [
          {
            "fr": "Puis-je vous parler un instant ?",
            "en": "May I talk with you for a moment?"
          },
          {
            "fr": "Nous visitons Strasbourg avec notre groupe",
            "en": "We are visiting Strasbourg with our group"
          },
          {
            "fr": "Je parle un peu français",
            "en": "I speak a little French"
          },
          {
            "fr": "Pouvez-vous parler plus lentement ?",
            "en": "Can you speak more slowly?"
          },
          {
            "fr": "Pouvez-vous répéter, s'il vous plaît ?",
            "en": "Could you repeat that, please?"
          },
          {
            "fr": "Quelle belle ville !",
            "en": "What a beautiful city!"
          }
        ]
      },
      {
        "id": "u4-l2",
        "title": "Offering kindness",
        "phrases": [
          {
            "fr": "Puis-je prier pour vous ?",
            "en": "May I pray for you?",
            "note": "France values privacy around faith. Ask gently, and be gracious if the answer is no."
          },
          {
            "fr": "Dieu vous aime",
            "en": "God loves you",
            "note": "Best said softly, once there is some warmth in the conversation."
          },
          {
            "fr": "Avez-vous besoin de quelque chose ?",
            "en": "Do you need anything?"
          },
          {
            "fr": "Bonne chance !",
            "en": "Good luck!"
          },
          {
            "fr": "Que Dieu vous bénisse",
            "en": "May God bless you",
            "note": "Unusual in everyday French; use it with people who are already open about faith. Otherwise, Je vous souhaite une belle journée."
          },
          {
            "fr": "Merci de votre temps",
            "en": "Thank you for your time"
          }
        ]
      },
      {
        "id": "u4-l3",
        "title": "Talking about faith",
        "phrases": [
          {
            "fr": "Est-ce que je peux vous poser une question ?",
            "en": "May I ask you a question?"
          },
          {
            "fr": "Nous sommes ici avec notre église",
            "en": "We are here with our church"
          },
          {
            "fr": "La foi est importante pour moi",
            "en": "Faith is important to me"
          },
          {
            "fr": "Qu'est-ce qui vous donne de l'espoir ?",
            "en": "What gives you hope?"
          },
          {
            "fr": "Est-ce que la foi compte pour vous ?",
            "en": "Does faith matter to you?",
            "note": "France is very secular (laïque) and many people keep faith private, so welcome any answer warmly."
          },
          {
            "fr": "Je peux vous raconter mon histoire ?",
            "en": "Can I tell you my story?",
            "note": "Ask before sharing; a short personal story lands better than an argument."
          },
          {
            "fr": "Je respecte votre point de vue",
            "en": "I respect your point of view"
          },
          {
            "fr": "Pas de problème, merci quand même",
            "en": "No problem, thanks anyway",
            "note": "If someone says no, end on a smile; a kind exit is a good witness too."
          }
        ]
      },
      {
        "id": "u4-l4",
        "title": "Prayer and encouragement",
        "phrases": [
          {
            "fr": "Comment puis-je prier pour vous ?",
            "en": "How can I pray for you?"
          },
          {
            "fr": "Je vais prier pour vous",
            "en": "I will pray for you"
          },
          {
            "fr": "Courage !",
            "en": "Hang in there!",
            "note": "Courage is everyday encouragement in France and carries no religious meaning."
          },
          {
            "fr": "Je pense à vous",
            "en": "I'm thinking of you"
          },
          {
            "fr": "Ne perdez pas espoir",
            "en": "Don't lose hope"
          },
          {
            "fr": "Dieu est fidèle",
            "en": "God is faithful"
          },
          {
            "fr": "Que la paix soit avec vous",
            "en": "Peace be with you",
            "note": "Familiar from church services, so it can feel formal in a casual chat."
          },
          {
            "fr": "Seigneur, merci pour cette journée",
            "en": "Lord, thank you for this day"
          }
        ]
      }
    ]
  },
  {
    "id": "u5",
    "title": "Les nombres",
    "blurb": "Numbers, time and days",
    "lessons": [
      {
        "id": "u5-l1",
        "title": "One to eight",
        "phrases": [
          {
            "fr": "Un",
            "en": "One (1)",
            "note": "Un becomes une before a feminine noun: une baguette."
          },
          {
            "fr": "Deux",
            "en": "Two (2)"
          },
          {
            "fr": "Trois",
            "en": "Three (3)"
          },
          {
            "fr": "Quatre",
            "en": "Four (4)"
          },
          {
            "fr": "Cinq",
            "en": "Five (5)",
            "note": "The q is pronounced when cinq stands alone."
          },
          {
            "fr": "Six",
            "en": "Six (6)"
          },
          {
            "fr": "Sept",
            "en": "Seven (7)",
            "note": "The p is silent: say 'set'."
          },
          {
            "fr": "Huit",
            "en": "Eight (8)"
          }
        ]
      },
      {
        "id": "u5-l2",
        "title": "Bigger numbers",
        "phrases": [
          {
            "fr": "Neuf",
            "en": "Nine (9)"
          },
          {
            "fr": "Dix",
            "en": "Ten (10)",
            "note": "Alone, dix sounds like 'deess'; the x is said as an s."
          },
          {
            "fr": "Douze",
            "en": "Twelve (12)"
          },
          {
            "fr": "Quinze",
            "en": "Fifteen (15)"
          },
          {
            "fr": "Vingt",
            "en": "Twenty (20)",
            "note": "The g and t are silent: vingt sounds like 'vin'."
          },
          {
            "fr": "Cinquante",
            "en": "Fifty (50)"
          },
          {
            "fr": "Soixante-dix",
            "en": "Seventy (70)",
            "note": "French counts seventy as sixty-ten; you can type it without the hyphen."
          },
          {
            "fr": "Cent",
            "en": "One hundred (100)"
          }
        ]
      },
      {
        "id": "u5-l3",
        "title": "Telling time",
        "phrases": [
          {
            "fr": "Quelle heure est-il ?",
            "en": "What time is it?"
          },
          {
            "fr": "Il est midi",
            "en": "It's noon"
          },
          {
            "fr": "Il est deux heures et demie",
            "en": "It's half past two"
          },
          {
            "fr": "Il est huit heures du soir",
            "en": "It's eight in the evening",
            "note": "Schedules use the 24-hour clock, so eight in the evening is written 20 h."
          },
          {
            "fr": "À quelle heure on se retrouve ?",
            "en": "What time are we meeting up?"
          },
          {
            "fr": "Rendez-vous à dix-huit heures",
            "en": "Let's meet at six p.m. (18:00)"
          },
          {
            "fr": "Je suis en retard",
            "en": "I'm running late"
          },
          {
            "fr": "Dans un quart d'heure",
            "en": "In a quarter of an hour"
          }
        ]
      },
      {
        "id": "u5-l4",
        "title": "Days of the week",
        "phrases": [
          {
            "fr": "On est quel jour ?",
            "en": "What day is it?"
          },
          {
            "fr": "On est jeudi",
            "en": "It's Thursday",
            "note": "Days of the week are not capitalized in French: lundi, mardi, jeudi."
          },
          {
            "fr": "Demain matin",
            "en": "Tomorrow morning"
          },
          {
            "fr": "Hier soir",
            "en": "Yesterday evening"
          },
          {
            "fr": "Ce week-end",
            "en": "This weekend"
          },
          {
            "fr": "Le musée est fermé le lundi",
            "en": "The museum is closed on Mondays"
          },
          {
            "fr": "Les magasins ferment le dimanche",
            "en": "Shops close on Sundays",
            "note": "Most shops in Alsace close on Sunday, so stock up on Saturday."
          },
          {
            "fr": "Je rentre aux États-Unis samedi",
            "en": "I go back to the US on Saturday"
          }
        ]
      }
    ]
  },
  {
    "id": "u6",
    "title": "Au marché",
    "blurb": "Prices, paying and shopping",
    "lessons": [
      {
        "id": "u6-l1",
        "title": "Prices and paying",
        "phrases": [
          {
            "fr": "Combien coûte ce bretzel ?",
            "en": "How much is this pretzel?",
            "note": "The bretzel is an Alsatian classic, sold in most bakeries."
          },
          {
            "fr": "Ça fait cinq euros",
            "en": "That comes to five euros"
          },
          {
            "fr": "Trois euros cinquante",
            "en": "Three euros fifty (3.50)"
          },
          {
            "fr": "Je peux payer par carte ?",
            "en": "Can I pay by card?"
          },
          {
            "fr": "En espèces",
            "en": "In cash"
          },
          {
            "fr": "Vous avez de la monnaie ?",
            "en": "Do you have change?",
            "note": "Monnaie means change or coins, not money in general (that is argent)."
          },
          {
            "fr": "Je peux avoir un reçu ?",
            "en": "Can I have a receipt?"
          },
          {
            "fr": "C'est trop cher pour moi",
