      { "fr": "Bonne journée", "en": "Have a good day" } ] },
    { "id": "u1-l2", "title": "Meeting someone", "phrases": [
      { "fr": "Comment vous appelez-vous ?", "en": "What is your name?" },
      { "fr": "Je m'appelle Marie", "en": "My name is Marie" },
      { "fr": "Enchanté", "en": "Nice to meet you" },
      { "fr": "Comment allez-vous ?", "en": "How are you?" },
