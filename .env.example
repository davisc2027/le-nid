# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose

# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Random string; Vercel Cron sends it as a bearer token to /api/cron/reminders
CRON_SECRET=

# DeepL API Free key (deepl.com/pro-api, free plan: 500k characters/month)
# Optional. DeepL is tried first when set; Groq language models translate when it is missing or out of allowance.
DEEPL_API_KEY=

# Groq API key for Conversation mode speech to text (free key from console.groq.com -> API Keys).
# Server only. One key is shared by the whole group (about 20 requests/minute, ~8 hours of audio/day).
GROQ_API_KEY=
# Optional: comma-separated Groq models used for translation, in order (default: openai/gpt-oss-120b,openai/gpt-oss-20b; the Llama 3.x models were retired on Groq free accounts on 2026-08-16)
GROQ_TRANSLATE_MODELS=
# Optional: Whisper model for Conversation mode (default whisper-large-v3-turbo; whisper-large-v3 is allowed for A/B tests)
STT_MODEL=
# Optional: DeepL glossary ids printed by `node scripts/sync-deepl-glossary.mjs` (faith terms and names, EN->FR and FR->EN)
DEEPL_GLOSSARY_EN_FR=
DEEPL_GLOSSARY_FR_EN=

# Weekly to-do summary email (Mondays). Use the SAME mailbox as Supabase's custom SMTP for sign-in codes.
# Gmail: host smtp.gmail.com, port 465, user = the Gmail address, pass = the 16-character app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Le Nid <you@gmail.com>
# Alternative to SMTP: Resend (needs a verified sending domain). Ignored when SMTP_USER and SMTP_PASS are set.
RESEND_API_KEY=
