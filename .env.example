# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose

# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Random string; Vercel Cron sends it as a bearer token to /api/cron/reminders
CRON_SECRET=

# DeepL API Free key (deepl.com/pro-api, free plan: 500k characters/month)
DEEPL_API_KEY=

# Optional email backup for reminders (resend.com; needs a verified sending domain)
RESEND_API_KEY=
EMAIL_FROM=Le Nid <nid@yourdomain.com>
